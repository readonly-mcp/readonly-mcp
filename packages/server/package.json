{
  "name": "@readonly-mcp/server",
  "version": "1.0.0",
  "description": "Security-hardened MCP server providing read-only CLI access for AI agents",
  "homepage": "https://github.com/readonly-mcp/readonly-mcp/tree/main/packages/server",
  "bugs": "https://github.com/readonly-mcp/readonly-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/readonly-mcp/readonly-mcp.git",
    "directory": "packages/server"
  },
  "license": "MIT",
  "type": "module",
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#test/*.js": "./test/*.ts"
  },
  "bin": {
    "readonly-mcp": "./dist/source/src/index.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "build": "pnpm run compile:ts && node scripts/stage-package.ts",
    "compile:ts": "tsc -p tsconfig.build.json",
    "lint:eslint": "eslint --max-warnings=0",
    "test": "vitest run",
    "typecheck:ts": "tsc"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@gtbuchanan/eslint-config": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "readonly-mcp": "./src/index.js"
    },
    "imports": {
      "#src/*.js": "./src/*.js"
    }
  }
}
