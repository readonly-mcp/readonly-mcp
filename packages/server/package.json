{
  "name": "@readonly-mcp/server",
  "version": "1.0.0",
  "description": "Security-hardened MCP server providing read-only CLI access for AI agents",
  "type": "module",
  "imports": {
    "#src/*.js": "./src/*.ts",
    "#test/*.js": "./test/*.ts"
  },
  "bin": {
    "readonly-mcp": "./dist/source/src/index.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "compile:ts": "gtb task compile:ts",
    "coverage:codecov:upload": "gtb task coverage:codecov:upload",
    "coverage:vitest:merge": "gtb task coverage:vitest:merge",
    "lint:eslint": "gtb task lint:eslint",
    "pack:npm": "gtb task pack:npm",
    "test:vitest:fast": "gtb task test:vitest:fast",
    "test:vitest:slow": "gtb task test:vitest:slow",
    "typecheck:ts": "gtb task typecheck:ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "catalog:",
    "@gtbuchanan/eslint-config": "catalog:",
    "@gtbuchanan/vitest-config": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "readonly-mcp": "./src/index.js"
    },
    "directory": "dist/source",
    "imports": {
      "#src/*.js": "./src/*.js"
    }
  }
}
